":"forge"},{"category":"crafting","difficulty":2,"id":"recipe_carve_fishing_rod","inputs":[{"count":1,"item":"item_log"}],"location":"loc_home_woodcutter","minLevel":0,"name":"Fishing Rod","note":"8 in, 25 out — Tam's craft, taught not taken. The teaching rule (x2 practice) applies to learning it.","outputs":[{"count":1,"item":"item_fishing_rod"}],"permission":{"npc":"npc_tam_oakes","what":"use of the workbench and teaching"},"qualityRule":{"formula":"clamp(avgInputQuality, 0, 100)"},"skill":null,"timeMinutes":120,"tool":"workbench"},{"category":"crafting","difficulty":1,"id":"recipe_patch_tool","inputs":[{"count":1,"item":"item_iron_stock"}],"location":"loc_blacksmith","minLevel":0,"name":"Patch a Tool","note":"15 in vs. the 8/25-copper service_repair in the economy — comparable, and available at midnight when Doran is asleep.","outputs":[{"repair":{"conditionRestored":30,"targetCategory":"tool"}}],"permission":{"npc":"npc_doran_kettle","what":"use of the forge"},"qualityRule":{"formula":"n/a - repair, not creation"},"skill":null,"timeMinutes":30,"tool":"forge"},{"category":"crafting","difficulty":1,"id":"recipe_sharpen_blade","inputs":[],"location":null,"minLevel":1,"name":"Sharpen a Blade","note":"Free, but skill-gated: a swordsman maintains their own blade — part of what the 120-copper sword investment buys. Done wherever the player rests.","outputs":[{"repair":{"conditionRestored":15,"targetCategory":"weapon"}}],"qualityRule":{"formula":"n/a - repair, not creation"},"skill":"skill_swordsmanship","timeMinutes":20,"tool":"whetstone"}],"version":1}